# ---- Server environment variables ----
# Copy to .env for local dev, and set these in your host (Render) dashboard for prod.

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/aibrain?retryWrites=true&w=majority

# Google Gemini API key
GEMINI_API_KEY=your-gemini-key

# Google OAuth credentials (Google Cloud Console > Credentials)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Public URL of THIS server (no trailing slash). Used to build the OAuth redirect URI.
# Local:  http://localhost:5000
# Prod:   https://your-server.onrender.com
SERVER_URL=http://localhost:5000

# Public URL of the React client (where users are sent after login).
# Local:  http://localhost:3000
# Prod:   https://your-app.vercel.app
CLIENT_URL=http://localhost:3000

# Public URL of the Python OCR service.
# Local:  http://127.0.0.1:8000
# Prod:   https://your-ai-service.onrender.com
AI_SERVICE_URL=http://127.0.0.1:8000

# PORT is injected automatically by most hosts; only set locally if needed.
# PORT=5000
