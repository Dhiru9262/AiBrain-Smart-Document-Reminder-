# ---- AI service environment variables ----
# Only needed if Tesseract is installed in a non-default location.
# On Linux hosts (Docker) Tesseract is on PATH, so leave this unset.
# On Windows local dev the default C:\Program Files path is used automatically.
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# PORT is injected automatically by the host; defaults to 8000 locally.
# PORT=8000
